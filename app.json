{
  "expo": {
    "name": "DRC Elite Golf",
    "slug": "drc-elite-golf",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./content.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./content.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECE8DF"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow DRC Elite Golf to use the microphone for DRC Voice.",
          "speechRecognitionPermission": "Allow DRC Elite Golf to recognise speech for DRC Voice."
        }
      ]
    ],
    "android": {
      "package": "com.dalecopeland.drcelitegolf",
      "versionCode": 10,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./content.png",
        "backgroundColor": "#ECE8DF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "bfde93e4-409b-40e0-87d4-0675f85b1534"
      }
    }
  }
}
